# Required for the AI chat widget (POST /api/chat)
# Set this in Netlify: Site configuration → Environment variables
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for form notifications (POST /api/form): every contact and partner
# form submission is emailed to ADMIN_EMAIL through Resend, including the ones
# Netlify's spam filter files under Spam. Same values as the client zone.
# Set these in Netlify too; a change takes effect on the next deploy.
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM="DRP BuildLab <info@drpbuildlab.com>"
# One address, or several separated by commas
ADMIN_EMAIL=info@drpbuildlab.com
